# 1. Абстрактный класс (Требование: наследование от абстрактного класса)
class ClinicEntity(ABC):
    def __init__(self, entity_id, name):
        self.__id = entity_id
        self.__name = name

    @abstractmethod
    def get_role(self):
        pass

    # Геттеры и сеттеры (Требование: атрибуты должны иметь геттеры и сеттеры)
    @property
    def id(self):
        return self.__id

    @id.setter
    def id(self, value):
        if isinstance(value, int) and value > 0:
            self.__id = value

    @property
    def name(self):
        return self.__name

    @name.setter
    def name(self, value):
        if isinstance(value, str) and len(value) > 0:
            self.__name = value

    # Магические методы (Требование: __eq__, __repr__, __str__)
    def __eq__(self, other):
        if isinstance(other, ClinicEntity):
            return self.__id == other.__id
        return False

    def __repr__(self):
        return f"<{self.__class__.__name__}(id={self.__id}, name='{self.__name}')>"

    def __str__(self):
        return f"{self.get_role()}: {self.__name} (ID: {self.__id})"


# 2. Сравнимость (Требование: классы должны быть сравнимы)
@total_ordering
class Patient(ClinicEntity):
    def __init__(self, entity_id, name, age, is_insured):
        super().__init__(entity_id, name)
        self.__age = age
        self.__is_insured = is_insured

    def get_role(self):
        return "Пациент"

    @property
    def age(self):
        return self.__age

    @age.setter
    def age(self, value):
        if 0 < value < 120:
            self.__age = value

    # Метод объекта (Требование: функциональность через методы объекта)
    def calculate_discount(self):
        return 20.0 if self.__is_insured else 0.0

    # Сравнимость (по возрасту)
    def __lt__(self, other):
        if isinstance(other, Patient):
            return self.__age < other.__age
        return NotImplemented

    def __hash__(self):
        return hash(self.id)


@total_ordering
class Doctor(ClinicEntity):
    def __init__(self, entity_id, name, specialization):
        super().__init__(entity_id, name)
        self.__specialization = specialization

    def get_role(self):
        return "Врач"

    @property
    def specialization(self):
        return self.__specialization

    @specialization.setter
    def specialization(self, value):
        self.__specialization = str(value)

    # Статический метод (Требование: функциональность через @staticmethod)
    @staticmethod
    def get_clinic_address():
        return "г. Москва, ул. Стоматологическая, д. 1"

    def __lt__(self, other):
        if isinstance(other, Doctor):
            return self.id < other.id
        return NotImplemented


# 3. Запрет dict (Требование: для маппинга использовать свой кастомный класс)
class MapNode:
    def __init__(self, key, value):
        self.key = key
        self.value = value

class CustomMap:
    def __init__(self):
        self._nodes = []

    def set_item(self, key, value):
        for node in self._nodes:
            if node.key == key:
                node.value = value
                return
        self._nodes.append(MapNode(key, value))

    def get_item(self, key):
        for node in self._nodes:
            if node.key == key:
                return node.value
        return None

    def get_all_values(self):
        return [node.value for node in self._nodes]


