class DentalClinicApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Стоматология 'Здоровый Улыб'")
        self.resize(800, 600)
        
        # Время входа (Для отчета)
        self.time_in = datetime.now()
        self.login = "admin"
        self.user_name = "Главный Врач"

        # Создаем 10 кастомных объектов (Требование: не менее 10 объектов)
        self.patients_map = CustomMap()
        self.patients_list = []
        for i in range(1, 11):
            p = Patient(i, f"Пациент_{i}", 20 + i, i % 2 == 0)
            self.patients_list.append(p)
            self.patients_map.set_item(i, p)

        self.init_ui()

    def init_ui(self):
        central_widget = QWidget()
        self.setCentralWidget(central_widget)
        
        # Выравнивание (Требование: все компоненты должны быть выровнены)
        main_layout = QVBoxLayout()
        main_layout.setAlignment(Qt.AlignmentFlag.AlignTop)
        
        # --- 10 UI КОМПОНЕНТОВ ---
        
        # 1. QLabel
        self.lbl_title = QLabel("РЕГИСТРАЦИЯ НА ПРИЕМ")
        self.lbl_title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.lbl_title.setStyleSheet("font-size: 18px; font-weight: bold;")
        main_layout.addWidget(self.lbl_title)

        form_layout = QGridLayout()
        
        # 2. QLineEdit
        self.txt_name = QLineEdit()
        self.txt_name.setPlaceholderText("Введите ФИО пациента")
        form_layout.addWidget(QLabel("ФИО:"), 0, 0)
        form_layout.addWidget(self.txt_name, 0, 1)

        # 3. QComboBox
        self.cmb_doctor = QComboBox()
        self.cmb_doctor.addItems(["Терапевт", "Хирург", "Ортодонт", "Пародонтолог"])
        form_layout.addWidget(QLabel("Врач:"), 1, 0)
        form_layout.addWidget(self.cmb_doctor, 1, 1)

        # 4. QDateEdit
        self.date_edit = QDateEdit()
        self.date_edit.setCalendarPopup(True)
        self.date_edit.setDate(QDate.currentDate())
        form_layout.addWidget(QLabel("Дата:"), 2, 0)
        form_layout.addWidget(self.date_edit, 2, 1)

        # 5. QTimeEdit
        self.time_edit = QTimeEdit()
        self.time_edit.setTime(QTime.currentTime())
        form_layout.addWidget(QLabel("Время:"), 3, 0)
        form_layout.addWidget(self.time_edit, 3, 1)

        main_layout.addLayout(form_layout)

        btn_layout = QHBoxLayout()
        
        # 6. QCheckBox
        self.chk_insurance = QCheckBox("По полису ДМС")
        btn_layout.addWidget(self.chk_insurance)

        # 7. QRadioButton
        self.radio_urgent = QRadioButton("Срочный прием")
        btn_layout.addWidget(self.radio_urgent)

        main_layout.addLayout(btn_layout)

        # 8. QProgressBar
        self.progress_load = QProgressBar()
        self.progress_load.setValue(75)
        self.progress_load.setFormat("Загрузка слотов: %p%")
        main_layout.addWidget(self.progress_load)

        # 9. QPushButton
        self.btn_register = QPushButton("ЗАПИСАТЬ ПАЦИЕНТА")
        self.btn_register.clicked.connect(self.register_patient)
        main_layout.addWidget(self.btn_register)

        # 10. QTableWidget
        self.table = QTableWidget(10, 4)
        self.table.setHorizontalHeaderLabels(["ID", "Имя", "Возраст", "ДМС"])
        self.table.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.Stretch)
        self.fill_table()
        main_layout.addWidget(self.table)

        central_widget.setLayout(main_layout)

    def fill_table(self):
        # Демонстрация работы с 10 объектами и их сравнимостью
        sorted_patients = sorted(self.patients_list) # Работает благодаря __lt__
        for row, patient in enumerate(sorted_patients):
            self.table.setItem(row, 0, QTableWidgetItem(str(patient.id)))
            self.table.setItem(row, 1, QTableWidgetItem(patient.name))
            self.table.setItem(row, 2, QTableWidgetItem(str(patient.age)))
            self.table.setItem(row, 3, QTableWidgetItem("Да" if patient.age % 2 == 0 else "Нет"))

    def register_patient(self):
        name = self.txt_name.text()
        if not name:
            QMessageBox.warning(self, "Ошибка", "Введите ФИО!")
            return
        
        # Демонстрация статического метода
        address = Doctor.get_clinic_address()
        QMessageBox.information(self, "Успех", f"Пациент {name} записан!\nАдрес клиники: {address}")

    # ТРЕБОВАНИЕ: При закрытии приложения окно должно быть сохранено в файл отчета
    def closeEvent(self, event):
        time_out = datetime.now()
        fmt = "%d.%m.%Y %H:%M:%S"
        
        # Формат из ТЗ: | login | time_in | time_out | UserName | <datatime> | <datatime> |
        report_line = (
            f"| {self.login} | {self.time_in.strftime(fmt)} | {time_out.strftime(fmt)} | "
            f"{self.user_name} | {self.time_in.strftime(fmt)} | {time_out.strftime(fmt)} |\n"
        )
        
        filename = "report.txt"
        try:
            with open(filename, "a", encoding="utf-8") as f:
                f.write(report_line)
            print(f"[СИСТЕМА] Отчет успешно сохранен в {filename}")
        except Exception as e:
            print(f"[ОШИБКА] Не удалось сохранить отчет: {e}")
            
        event.accept()


